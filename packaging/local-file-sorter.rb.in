cask "local-file-sorter" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/OmTheLast/local-file-sorter/releases/download/v#{version}/LocalFileSorter-#{version}-arm64.zip"
  name "Local File Sorter"
  desc "Sort downloads using rules and on-device Apple Intelligence"
  homepage "https://github.com/OmTheLast/local-file-sorter"

  depends_on arch: :arm64
  depends_on macos: :tahoe

  app "Local File Sorter.app"

  uninstall quit: "local.ompatnaik.LocalFileSorter"

  caveats <<~EOS
    Open Local File Sorter and enable automatic sorting to begin.
    Apple Intelligence is optional; rules and Needs Review work without it.
    Uninstall preserves sorted files, settings, and undo history.
  EOS
end
